# Video Understanding - configuration
#
#   cp .env.example .env
#
# Every value here has a working default; this file exists to show you what is
# tunable. Precedence: defaults < config.yaml < .env < real environment vars.

# =============================================================================
# Models
# =============================================================================
# No model name is hard-coded anywhere in the codebase. Change these and the
# pipeline uses the new model - no code changes.

# --- Speech to text ---
# whisper | mock | null      (mock = deterministic fake, null = skip the stage)
TRANSCRIPTION_PROVIDER=whisper
# tiny | base | small | medium | large-v3   (see the README sizing table)
WHISPER_MODEL=small
# auto | cpu | cuda          (faster-whisper has no Metal backend; CPU on Macs)
WHISPER_DEVICE=auto
# auto | int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
# Force a language (e.g. en) instead of auto-detecting it. Empty = auto.
WHISPER_LANGUAGE=

# --- Vision (frame analysis) ---
# ollama | mock | null
VISION_PROVIDER=ollama
# Must be a vision-capable model. Pull it first: ollama pull qwen2.5vl:7b
VISION_MODEL=qwen2.5vl:7b

# --- Reasoning (summary, highlights, edits) ---
# ollama | mock | null       (null falls back to the built-in heuristics)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b

# --- Ollama connection ---
# Running natively:  http://localhost:11434
# Running in Docker: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2

# =============================================================================
# Video limits and frame sampling
# =============================================================================
# The core cost control: scenes x frames_per_scene, capped at max_frames.
# 60s video -> ~10 scenes -> 3 frames each -> 30 frames sent to the VLM.
VIDEO_MAX_DURATION_SECONDS=180
VIDEO_MAX_UPLOAD_MB=512
VIDEO_FRAMES_PER_SCENE=3
VIDEO_MAX_FRAMES=100
# Frames are downscaled to this width before being sent to the vision model.
VIDEO_FRAME_WIDTH=768
VIDEO_ALLOWED_EXTENSIONS=.mp4,.mov,.m4v,.avi,.mkv,.webm

# =============================================================================
# Scene detection
# =============================================================================
# auto          - PySceneDetect, falling back to ffmpeg, falling back to uniform
# pyscenedetect - content-aware (needs: pip install 'video-understanding[scenes]')
# ffmpeg        - the built-in `scene` filter, no extra dependencies
# uniform       - fixed-length chunks; never fails
SCENE_DETECTOR=auto
# PySceneDetect content threshold. Lower = more cuts detected.
SCENE_THRESHOLD=27.0
# FFmpeg `scene` filter threshold (0-1). Real cuts typically score 0.2-0.6.
SCENE_FFMPEG_THRESHOLD=0.25
# Scenes shorter than this are merged into their neighbour.
SCENE_MIN_DURATION=1.5
# Chunk length used by the `uniform` detector.
SCENE_UNIFORM_DURATION=6.0

# =============================================================================
# Server and storage
# =============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

DATA_DIR=data
OUTPUT_DIR=output
# Defaults to $DATA_DIR/videos.db
# DATABASE_PATH=

# Local model inference is memory-bound: two concurrent jobs on a 16 GB Mac
# will swap rather than go faster. Raise only if you have RAM to spare.
WORKER_COUNT=1
JOB_TIMEOUT_SECONDS=3600

# Keep extracted audio and frames after processing (debugging).
KEEP_INTERMEDIATE_FILES=false

# =============================================================================
# Error handling
# =============================================================================
# false - a failing AI stage degrades gracefully and is recorded in `warnings`
#         (e.g. Ollama down -> heuristic summary instead of no result at all)
# true  - any provider failure fails the whole job
FAIL_ON_PROVIDER_ERROR=false
